<odoo>
    <record id="payment_provider_square" model="payment.provider">
        <field name="name">Square</field>
        <field name="provider">square</field>
        <field name="state">enabled</field>  
        <field name="pos_terminal_provider">True</field>
        <field name="payment_method_ids" eval="[(6, 0, [ref('payment_method_square_card'), ref('payment_method_square_terminal')])]"/>
    </record>

</odoo>
