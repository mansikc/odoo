<odoo>
    <record id="pos_payment_method_form_view_inherit" model="ir.ui.view">
        <field name="name">pos.payment.method.form.view.inherit.square</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <field name="use_payment_terminal" position="after">
                <field name="square_device_id" attrs="{'required': [('use_payment_terminal', '=', 'square_terminal')], 'invisible': [('use_payment_terminal', '!=', 'square_terminal')]}"/>
            </field>
        </field>
    </record>
</odoo>
