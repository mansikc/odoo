<odoo>
  <!-- Square Card -->
  <record id="pos_payment_method_square_card" model="payment.method">
    <field name="name">Square Card</field>
    <field name="active" eval="True"/>
    <field name="code">square_card</field>
  </record>

  <!-- Square Terminal -->
  <record id="pos_payment_method_square_terminal" model="payment.method">
    <field name="name">Square Terminal</field>
    <field name="active" eval="True"/>
    <field name="code">square</field>
  </record>
</odoo>
