<odoo>
    <record id="view_square_config_form" model="ir.ui.view">
        <field name="name">square.config.form</field>
        <field name="model">square.config</field>
        <field name="arch" type="xml">
            <form string="Square Configuration">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="access_token"/>
                        <field name="location_id"/>
                        <field name="device_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_square_config_tree" model="ir.ui.view">
        <field name="name">square.config.tree</field>
        <field name="model">square.config</field>
        <field name="arch" type="xml">
            <list string="Square Configurations">
                <field name="name"/>
                <field name="location_id"/>
                <field name="device_id"/>
            </list>
        </field>
    </record>
<!-- 
<menuitem id="square_config_menu"
              name="Square Terminal"
              parent="point_of_sale.menu_pos_root"
              sequence="10"/> -->

    <menuitem id="square_config_submenu"
              name="Configuration"
              parent="square_config_menu"
              action="action_square_config"/>


    <record id="action_square_config" model="ir.actions.act_window">
        <field name="name">Square Configuration</field>
        <field name="res_model">square.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="square_config_action_menu" name="Configurations"
              parent="square_config_submenu"
              action="action_square_config"/>
</odoo>
