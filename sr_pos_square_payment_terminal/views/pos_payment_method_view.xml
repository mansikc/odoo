<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="sr_pos_payment_method_view_form" model="ir.ui.view">
        <field name="name">pos.payment.method.view.form</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/group" position="inside">
                <field name="is_square_payment"/>
                <field name="test_mode" invisible="not is_square_payment"/>
<!--                <field name="location" invisible="not is_square_payment"/>-->
                <field name="token" invisible="not is_square_payment"/>
                <label for="location" invisible="not is_square_payment"/>
                <div class="o_row" col="2" invisible="not is_square_payment">
                    <field name="location"/>
                    <button class="oe_link" icon="fa-refresh" type="object" name="action_generate_location" string="Generate LocationID"/>
                </div>
                <field name="generated_device_code"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="generate_device" string="Genrate Device" class="oe_highlight" type="object" />
                    <button name="get_device" string="Get Device" class="oe_highlight" type="object" />
                </header>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook invisible="not is_square_payment">
                    <page string="Devices">
                        <field name="device_ids" readonly="0">
                            <list editable="bottom">
                                <field name="device"/>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="location"/>
                                <field name="status"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

</odoo>
